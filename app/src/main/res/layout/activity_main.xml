<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●  TRANSFERENCIA FTP"
            android:textColor="@color/green"
            android:textSize="12sp"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="PKG Bridge"
            android:textColor="@color/primary"
            android:textSize="33sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="22dp"
            android:text="Envía tus archivos .pkg directamente a la PS4"
            android:textColor="@color/secondary"
            android:textSize="14sp" />

        <!-- CONFIGURACIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="01  CONEXIÓN"
                android:textColor="@color/blue_light"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Dirección IP de la PS4"
                android:textColor="@color/primary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/hostInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_input"
                android:hint="Ej.: 192.168.1.100"
                android:inputType="textNoSuggestions"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/primary"
                android:textColorHint="@color/secondary"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Puerto" android:textColor="@color/primary" android:textSize="13sp" />
                    <EditText android:id="@+id/portInput" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:background="@drawable/bg_input" android:inputType="number" android:maxLines="1" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="2121" android:textColor="@color/primary" android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="2" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Carpeta destino" android:textColor="@color/primary" android:textSize="13sp" />
                    <EditText android:id="@+id/dirInput" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:background="@drawable/bg_input" android:inputType="textNoSuggestions" android:maxLines="1" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="/data/pkg" android:textColor="@color/primary" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/advancedToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="▸  Opciones avanzadas (usuario y contraseña)"
                android:textColor="@color/secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/advancedSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Usuario FTP" android:textColor="@color/primary" android:textSize="13sp" />
                <EditText android:id="@+id/userInput" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:background="@drawable/bg_input" android:inputType="textNoSuggestions" android:maxLines="1" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="anonymous" android:textColor="@color/primary" android:textSize="14sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Contraseña FTP (opcional)" android:textColor="@color/primary" android:textSize="13sp" />
                <EditText android:id="@+id/passwordInput" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:background="@drawable/bg_input" android:inputType="textPassword" android:maxLines="1" android:paddingStart="14dp" android:paddingEnd="14dp" android:textColor="@color/primary" android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/testButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_outline_button"
                android:text="Probar conexión FTP"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- SELECCIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="02  SELECCIONA UN PKG" android:textColor="@color/blue_light" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/fileNameText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:ellipsize="middle" android:maxLines="2" android:text="Ningún archivo seleccionado" android:textColor="@color/primary" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/fileSizeText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Selecciona un archivo .pkg desde tu teléfono." android:textColor="@color/secondary" android:textSize="13sp" />
            <Button android:id="@+id/selectButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="18dp" android:background="@drawable/bg_outline_button" android:text="Elegir archivo .pkg" android:textAllCaps="false" android:textColor="@color/primary" android:textSize="14sp" />
            <Button android:id="@+id/uploadButton" android:layout_width="match_parent" android:layout_height="53dp" android:layout_marginTop="12dp" android:background="@drawable/bg_primary_button" android:enabled="false" android:text="↑  Enviar PKG a la PS4" android:textAllCaps="false" android:textColor="@color/primary" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- PROGRESO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="03  ESTADO DE TRANSFERENCIA" android:textColor="@color/blue_light" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="Listo para conectar" android:textColor="@color/secondary" android:textSize="15sp" />
            <ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="9dp" android:layout_marginTop="18dp" android:indeterminate="false" android:max="100" android:progress="0" android:progressTint="@color/blue" android:progressBackgroundTint="@color/input_stroke" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                <TextView android:id="@+id/progressText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0%" android:textColor="@color/primary" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/speedText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 MB/s" android:textColor="@color/secondary" android:textSize="13sp" />
            </LinearLayout>
            <Button android:id="@+id/cancelButton" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="14dp" android:background="@drawable/bg_outline_button" android:enabled="false" android:text="Cancelar transferencia" android:textAllCaps="false" android:textColor="@color/red" android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Usa la misma red local que la PS4 y mantén la app abierta durante el envío. FTP no cifra los datos."
            android:textColor="@color/secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
